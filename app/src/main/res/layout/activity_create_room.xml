<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/createRoom"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CreateRoomActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Screen 3 overlay -->
        <LinearLayout
            android:id="@+id/androidCompact3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#CCFFFFFF"
            android:padding="24dp">

            <TextView
                android:id="@+id/chatbotName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="채팅방 생성"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="200dp"
                android:layout_marginBottom="24dp"/>

            <!-- Chat room name input -->
            <EditText
                android:id="@+id/chatbotNameEdt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="채팅방 이름"
                android:background="@drawable/rounded_grey"
                android:padding="12dp"
                android:layout_marginBottom="16dp"/>

            <!-- File upload -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/file"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="문서 첨부하기"
                    android:background="@drawable/rounded_grey"
                    android:padding="12dp"

                    android:layout_marginEnd="10dp"
                    />

                <TextView
                    android:id="@+id/fileUploadBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="+"
                    android:textSize="20sp"
                    android:textColor="#000000"
                    android:gravity="center"
                    android:background="@drawable/rounded_grey"
                    android:padding="0dp" />

            </LinearLayout>

            <!--
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="파일 이름 어쩌구저쩌구.pdf"
                android:textSize="14sp"
                android:textColor="#000000"
                android:layout_marginBottom="24dp"/>-->

            <!-- Confirm button -->
            <Button
                android:id="@+id/btnConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="확 인"
                android:backgroundTint="#ADD8FF"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginTop="50dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="53dp"
            android:background="#D9EEFF"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ic_arrow"
                android:layout_width="52dp"
                android:layout_height="35dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/arrow" />

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="287dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="60dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/robot" />

        </LinearLayout>

    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>